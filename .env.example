# Copy this file to .env and fill in real provider credentials as needed.
# Demo mode is enabled by default, so empty API keys are allowed for local testing.

APP_NAME=football-intel-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEMO_MODE=true

REQUEST_TIMEOUT_SECONDS=10.0
CACHE_TTL_SECONDS=300

FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

THE_ODDS_API_KEY=""
THE_ODDS_BASE_URL=https://api.the-odds-api.com/v4

GOALSERVE_API_KEY=""
GOALSERVE_BASE_URL=https://www.goalserve.com/getfeed
